# 复制成 .env 并填入真实值。.env 已被 .gitignore 忽略，不要提交。
# GitHub Actions 用的是仓库 Settings > Secrets and variables > Actions，不是这个文件。

# 发件邮箱地址（不带显示名）。必填。config.json 里只有 ${SMTP_SENDER}，地址不出现在仓库。
SMTP_SENDER=

# 收件邮箱地址。多个用逗号分隔：a@x.com,b@y.com
# 必填。config.json 里只有 ${SMTP_RECIPIENTS}，地址不出现在仓库。
SMTP_RECIPIENTS=

# QQ 邮箱 SMTP 授权码（不是登录密码）。必填。
SMTP_PASSWORD=

# GitHub PAT，用于搜索新项目。可留空（GitHub 榜单会因匿名限流而变慢）。
GITHUB_TOKEN=

# 火山引擎机器翻译 AK/SK（可选）。两者都填才启用，否则自动回退 MyMemory。
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_REGION=cn-north-1