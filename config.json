{
  "email": {
    "smtp_host": "smtp.qq.com",
    "smtp_port": 465,
    "use_tls": false,
    "use_ssl": true,
    "sender": "${SMTP_SENDER}",
    "password": "${SMTP_PASSWORD}",
    "sender_name": "每日科技新闻",
    "recipients": [
      "${SMTP_RECIPIENTS}"
    ]
  },
  "settings": {
    "timezone": "Asia/Shanghai",
    "hours_lookback": 24,
    "max_per_category": 8,
    "max_per_category_by": {
      "网络安全": 12,
      "硬件极客": 12
    },
    "subject_prefix": "【每日科技新闻】",
    "request_timeout": 20,
    "translate": true,
    "translate_target": "zh",
    "translate_delay": 0.25,
    "translate_workers": 4,
    "translate_summary": true,
    "translate_max_requests": 80,
    "fetch_og_image": true,
    "og_image_delay": 0.2,
    "og_image_limit": 60,
    "og_image_workers": 6,
    "fetch_workers": 10,
    "send_after_hour": 8,
    "send_retries": 3,
    "send_retry_delay": 15,
    "github_trending": true,
    "github_count": 20,
    "github_since_days": 7,
    "github_min_stars": 100,
    "github_lookback_days": 60,
    "github_search_pages": 3,
    "github_pool_max": 600
  },
  "translate": {
    "provider": "volcengine",
    "volc_access_key": "${VOLC_ACCESS_KEY:-}",
    "volc_secret_key": "${VOLC_SECRET_KEY:-}",
    "volc_region": "cn-north-1"
  },
  "github": {
    "token": "${GITHUB_TOKEN}"
  },
  "zeli": {
    "enabled": true,
    "rss": "https://zeli.app/zh/rss.xml",
    "limit": 15,
    "timeout": 60,
    "retries": 3
  },
  "wuzao": {
    "enabled": true,
    "period": "daily",
    "limit": 30,
    "timeout": 30,
    "retries": 2,
    "fetch_descriptions": true
  },
  "archive": {
    "enabled": true,
    "dir": "history",
    "keep_days": 0
  },
  "alert": {
    "enabled": true,
    "desktop_copy": true
  },
